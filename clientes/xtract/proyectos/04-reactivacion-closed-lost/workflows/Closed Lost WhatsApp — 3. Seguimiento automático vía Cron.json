        200,
        300
      ],
      "id": "e319044f-0e16-4ebe-9b2b-a6a3c62d6f19"
    },
    {
      "parameters": {
        "jsCode": "// Configuración centralizada de Seguimiento\nreturn [{ json: {\n  CHATWOOT_URL: 'https://chatwoot.xtract.app',\n  CHATWOOT_ACCOUNT_ID: '1',\n  WA_SHEET_URL: 'https://docs.google.com/spreadsheets/d/1B7T1j6b8_8zC9Z0l1s7E_xR9U6q0Z2M4x0P_8t_Y5E/edit',\n  WA_SEGUIMIENTO_ESPERA_MIN: 120, // 2 horas\n  WA_SEGUIMIENTO_NAME: 'reactivacion_closed_lost_seguimiento',\n  WA_SEGUIMIENTO_LANG: 'es_AR',\n  WA_SEGUIMIENTO_PREVIEW: 'Nos juntamos hace un tiempo cuando en {{1}} estaban buscando automatizar el ingreso de facturas en {{2}}. Quería saber cómo vienen con ese proceso, si ya encontraron alguna forma de automatizarlo o si lo siguen haciendo de forma manual.'\n} }];"
      },
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "id": "4458317f-d86f-464f-bc44-a3c4858f7a22"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Config').first().json.WA_SHEET_URL }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Enviados WA"
        },
        "options": {}
      },
      "name": "Leer enviados WA",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        640,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "sgEH8OTRXcjJiTTc",
          "name": "SheetCuentaSantiago"
        }
      },
      "id": "e6a7ae34-7fd6-478b-a47a-8a1322f7a7b9"
    },
    {
      "parameters": {
        "jsCode": "// Filtrar leads que ya cumplieron las 2hs y no tienen seguimiento enviado ni respondido\nconst cfg = $('Config').first().json;\nconst esperaMs = (cfg.WA_SEGUIMIENTO_ESPERA_MIN || 120) * 60 * 1000;\nconst ahora = Date.now();\n\nconst elegibles = [];\nfor (const item of $input.all()) {\n  const row = item.json || {};\n  const estado = String(row.estado || '').toLowerCase();\n  const convId = row.chatwoot_conversation_id;\n  const seg = String(row.seguimiento || '').toLowerCase();\n  const fechaEnvioStr = row.fecha_envio;\n\n  // Solo enviados con conversación\n  if (estado !== 'enviado' || !convId) continue;\n  // Si ya se mandó seguimiento o ya respondió, saltear\n  if (seg === 'enviado' || seg === 'respondio' || seg === 'cancelado') continue;\n  if (!fechaEnvioStr) continue;\n\n  const fechaEnvio = new Date(fechaEnvioStr).getTime();\n  if (isNaN(fechaEnvio)) continue;\n\n  const antiguedad = ahora - fechaEnvio;\n  // Ventana: entre 2 horas y 48 horas\n  if (antiguedad >= esperaMs && antiguedad <= 48 * 60 * 60 * 1000) {\n    elegibles.push({ json: {\n      telefono: row.telefono,\n      nombre: row.nombre,\n      primer_nombre: row.primer_nombre || row.nombre,\n      empresa: row.empresa || 'tu empresa',\n      sistema: row.sistema || 'el sistema que usan',\n      conversation_id: convId,\n      fecha_envio: row.fecha_envio,\n      owner: row.owner\n    } });\n  }\n}\n\nreturn elegibles;"
      },
      "name": "Filtrar pendientes de seguimiento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ],
      "id": "e6343810-e218-4d5a-9654-1f485d54ebb0"
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "Loop de seguimiento",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1080,
        300
      ],
      "id": "5095c171-38e3-4b6c-a05e-ddb12949de9a"
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.CHATWOOT_URL }}/api/v1/accounts/{{ $('Config').first().json.CHATWOOT_ACCOUNT_ID }}/conversations/{{ $json.conversation_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 30000
