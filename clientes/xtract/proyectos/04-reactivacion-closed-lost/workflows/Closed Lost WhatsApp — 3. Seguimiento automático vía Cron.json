{
  "id": "KYqttVyQPTvG8xg6",
  "name": "Closed Lost WhatsApp — 3. Seguimiento automático vía Cron",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 9-19 * * 1-5"
            }
