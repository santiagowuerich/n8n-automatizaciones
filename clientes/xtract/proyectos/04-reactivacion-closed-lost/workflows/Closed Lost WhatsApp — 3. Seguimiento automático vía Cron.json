        "url": "={{ $('Config').first().json.CHATWOOT_URL }}/api/v1/accounts/{{ $('Config').first().json.CHATWOOT_ACCOUNT_ID }}/conversations/{{ $('Loop de seguimiento').item.json.conversation_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $('Config').first().json.WA_SEGUIMIENTO_PREVIEW, message_type: \"outgoing\", template_params: { name: $('Config').first().json.WA_SEGUIMIENTO_NAME || \"reactivacion_closed_lost_seguimiento\", category: \"marketing\", language: $('Config').first().json.WA_SEGUIMIENTO_LANG || \"es_AR\", processed_params: { \"1\": $('Loop de seguimiento').item.json.empresa || \"tu empresa\", \"2\": $('Loop de seguimiento').item.json.sistema || \"el sistema que usan\" } } }) }}",
        "options": {
