    "googleSheetsOAuth2Api": {
     "id": "sgEH8OTRXcjJiTTc",
     "name": "SheetCuentaSantiago"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Filtrar leads que ya cumplieron las 2hs y no tienen seguimiento enviado ni respondido\nconst cfg = $('Config').first().json;\nconst esperaMs = (cfg.WA_SEGUIMIENTO_ESPERA_MIN || 120) * 60 * 1000;\nconst ahora = Date.now();\nconst MAX_ANTIGUEDAD_MS = 7 * 24 * 60 * 60 * 1000; // 7 días max para cubrir fines de semana\n\nconst elegibles = [];\nfor (const item of $input.all()) {\n  const row = item.json || {};\n  const estado = String(row.estado || \"\").toLowerCase().trim();\n  const convId = row.chatwoot_conversation_id;\n  const seg = String(row.seguimiento || \"\").toLowerCase().trim();\n  const fechaEnvioStr = row.fecha_envio;\n\n  // Solo enviados con conversación\n  if (estado !== \"enviado\" || !convId) continue;\n  // Si ya se mandó seguimiento o ya respondió o cancelado, saltear\n  if (seg === \"enviado\" || seg === \"respondio\" || seg === \"cancelado\") continue;\n  if (!fechaEnvioStr) continue;\n\n  const fechaEnvio = new Date(fechaEnvioStr).getTime();\n  if (isNaN(fechaEnvio)) continue;\n\n  const antiguedad = ahora - fechaEnvio;\n  // Ventana: entre esperaMs (2hs) y 7 días\n  if (antiguedad >= esperaMs && antiguedad <= MAX_ANTIGUEDAD_MS) {\n    const rawSis = String(row.sistema || \"\").trim();\n    const sistemaLimpio = (!rawSis || rawSis.toLowerCase() === \"otro\" || rawSis.toLowerCase() === \"sistema propio\")\n      ? \"su sistema\"\n      : rawSis;\n\n    elegibles.push({ json: {\n      row_number: row.row_number,\n      telefono: row.telefono,\n      nombre: row.nombre,\n      primer_nombre: row.primer_nombre || row.nombre,\n      empresa: row.empresa || \"tu empresa\",\n      sistema: sistemaLimpio,\n      conversation_id: convId,\n      fecha_envio: row.fecha_envio,\n      owner: \"Nicolás González\"\n    } });\n  }\n}\n\nreturn elegibles;"
   },
