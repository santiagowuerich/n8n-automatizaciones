  {
   "parameters": {
    "jsCode": "// Configuración centralizada de Seguimiento\nreturn [{ json: {\n  CHATWOOT_URL: 'https://chatwoot.xtract.app',\n  CHATWOOT_ACCOUNT_ID: '1',\n  WA_SHEET_URL: 'https://docs.google.com/spreadsheets/d/1w6wVAuYmHjI8Fk4b3S1VLxAcgSSQkUjHOTrE1enmaP8/edit',\n  WA_SEGUIMIENTO_ESPERA_MIN: 180, // 3 horas\n  WA_SEGUIMIENTO_NAME: 'reactivacion_closed_lost_seguimiento',\n  WA_SEGUIMIENTO_LANG: 'es_AR',\n  WA_SEGUIMIENTO_PREVIEW: 'Nos juntamos hace un tiempo cuando en {{1}} estaban buscando automatizar el ingreso de facturas en {{2}}. Quería saber cómo vienen con ese proceso, si ya encontraron alguna forma de automatizarlo o si lo siguen haciendo de forma manual.'\n} }];"
   },
   "name": "Config",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    432,
    304
   ],
   "id": "4458317f-d86f-464f-bc44-a3c4858f7a22"
  },
  {
