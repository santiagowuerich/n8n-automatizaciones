    function setDeviceView(mode) {
      const container = document.getElementById('emailViewport');
      const btnDesktop = document.getElementById('btnViewDesktop');
      const btnMobile = document.getElementById('btnViewMobile');

      if (mode === 'mobile') {
        container.style.maxWidth = '390px';
        btnMobile.className = 'px-3 py-1.5 rounded-md font-medium transition bg-gray-800 text-white shadow-sm flex items-center gap-1.5';
        btnDesktop.className = 'px-3 py-1.5 rounded-md font-medium transition text-gray-400 hover:text-gray-200 flex items-center gap-1.5';
      } else {
        container.style.maxWidth = '540px';
        btnDesktop.className = 'px-3 py-1.5 rounded-md font-medium transition bg-gray-800 text-white shadow-sm flex items-center gap-1.5';
        btnMobile.className = 'px-3 py-1.5 rounded-md font-medium transition text-gray-400 hover:text-gray-200 flex items-center gap-1.5';
      }
    }

    function showToast(title, message) {
      const toast = document.getElementById('toastNotification');
      document.getElementById('toastTitle').innerText = title;
      document.getElementById('toastMessage').innerText = message;

      toast.classList.remove('translate-y-24', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-24', 'opacity-0');
      }, 3200);
    }

    function copyRawHtml() {
      const code = generateCleanEmailCode();
      navigator.clipboard.writeText(code).then(() => {
        showToast('¡HTML Copiado!', 'Pegalo directamente en tu herramienta de email o campaña en frío.');
      }).catch(() => {
        showToast('Error', 'No se pudo copiar automáticamente.');
      });
    }

